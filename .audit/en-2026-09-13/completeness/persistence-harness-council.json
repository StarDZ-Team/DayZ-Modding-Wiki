  "accepted": [
    "CE custom types include syntax and complete flags field",
    "controlled zero-spawn and long-lifetime type values as hypotheses",
    "persistent creation-flag hypothesis with no no-persist/dynamic-persist/local flags",
    "CE-finished plus per-run trigger readiness gate",
    "instanceId 1 plus -storage branch mapping to storage_1 in the retained run",
    "active messages countdown as the official scheduled-shutdown route",
    "immutable same-v1, migration, true-resave/reload, and repeated bad/control matrix",
    "fresh-process readback as the practical persistence criterion",
    "public mods bounded to third-party implementation evidence"
  ],
  "rejectedOrCorrected": [
    "CE eligibility plus flags guarantees persistence",
    "the pinned commented messages.xml example is itself an active five-minute shutdown",
    "types.xml alone proves Fence or WoodenCrate persistence",
    "self-exit, delay, OnStoreSave, or hash changes prove commit or flush",
    "public-mod behavior or native declarations prove persistence",
    "crash, RestartMission, RequestExit, Ctrl+C, Stop-Process, or Kill counts as graceful completion"
  ],
  "minimumCorrections": [
    {"id": "HC-01", "topic": "fixture-interface", "required": "Re-read repaired files and require v1 label setter plus label/charge getters; v2 label setter plus label/charge/locked getters; matrix full interface."},
    {"id": "HC-02", "topic": "compile-smoke", "required": "Use positive module/type/config witnesses and candidate/new-error rejection with a narrow exact baseline allowlist; do not require zero SCRIPT (E) lines globally."},
    {"id": "HC-03", "topic": "timing", "required": "For deadline 5, refuse state-changing trigger after T+180s, require phase-ready by T+210s and before shutdown state, wait to declared self-exit bound such as T+420s, then invalidate before cleanup."},
    {"id": "HC-04", "topic": "correlation", "required": "Unique run ID/profile/logs and trigger; phase plus run ID in trigger and every marker; reject stale/unscoped markers."},
    {"id": "HC-05", "topic": "persistent-id", "required": "Establish canonical per-label PIDs at seed if nonzero, otherwise first same-v1 reload; require clone-derived continuity for all valid records."},
    {"id": "HC-06", "topic": "stage-assertions", "required": "Require exact schema/value callback sets before mutation and time-correlate required saves after mutation/phase-ready."},
    {"id": "HC-07", "topic": "snapshot-isolation", "required": "Clone after self-exit and handle/port release; reject links/reparse points; require equal sorted path/size/SHA256 manifests and re-hash immutable sources."},
    {"id": "HC-08", "topic": "bad-matrix", "required": "Set storageAutoFix=0 explicitly, require both valid controls, and preserve/report CE-init or control failure without blind timing variations."}
  ],
