    {
      "id": "SR2-001",
      "page": "en/05-config-files/05-server-configs.md",
      "disposition": "accept exact repair",
      "old_text": "A JSON file in the mission root that the engine loads automatically if present.",
      "final_new_text": "A JSON file in the mission root that the dedicated server loads when `enableCfgGameplayFile = 1` is set in `serverDZ.cfg`.",
      "reason": "Pinned handler and official Gameplay Settings both establish the activation gate.",
      "council_json": "council-early.json",
      "council_report": "council-early-REPORT.md",
      "editorial_outcome": "accepted"
    },
    {
      "id": "SR2-002",
      "page": "en/05-config-files/05-server-configs.md",
      "disposition": "accept exact repair",
      "old_text": "A JSON syntax error causes the file to be silently ignored --- the server runs with defaults and nothing in the log points at the file.",
      "final_new_text": "A JSON load failure is reported through `ErrorEx(errorMessage)`. Check the script error output and validate the JSON before restarting; do not assume the file is silently ignored or that every setting falls back to its default.",
      "reason": "Pinned handler explicitly calls ErrorEx and does not establish an all-default fallback.",
      "council_json": "council-early.json",
      "council_report": "council-early-REPORT.md",
      "editorial_outcome": "accepted"
    },
    {
      "id": "SR2-003",
      "page": "en/05-config-files/05-server-configs.md",
      "disposition": "accept exact repair",
      "old_text": "Note that a JSON syntax error causes the whole file to be **silently ignored**, so admins should validate it after every edit.",
      "final_new_text": "The loader reports JSON load failures through `ErrorEx(errorMessage)`, so admins should check the script error output and validate the file after every edit.",
      "reason": "Pinned handler explicitly calls ErrorEx on LoadFile failure.",
      "council_json": "council-early.json",
      "council_report": "council-early-REPORT.md",
      "editorial_outcome": "accepted"
    },
    {
      "id": "SR2-004",
      "page": "en/09-server-admin/01-server-setup.md",
      "line": 35,
      "disposition": "reject",
      "old_text": "DayZ Server is single-threaded for gameplay logic. Clock speed matters more than core count.",
      "final_new_text": null,
      "reason": "Replication workers and generic parallel-task processing do not prove that gameplay/script logic is multithreaded; the original sentence is expressly limited to gameplay logic.",
      "council_json": "council-server-extra.json",
      "council_report": "council-server-extra-REPORT.md",
      "editorial_outcome": "rejected"
    },
    {
      "id": "SR2-005",
      "page": "en/09-server-admin/01-server-setup.md",
      "line": 294,
      "disposition": "accept exact repair",
      "old_text": "This is normal. DayZ Server is single-threaded. Do not run multiple server instances on the same core -- use processor affinity or separate machines.",
      "final_new_text": "High utilization on one core can reflect a main-thread bottleneck, but the server also uses parallel tasks and can use multithreaded replication. Check server FPS and profile the workload before assigning affinity; size replication workers through `dayzsettings.xml` when `multithreadedReplication` is enabled.",
      "reason": "The unqualified whole-server statement conflicts with documented replication workers and -cpuCount parallel-task processing; the repair does not claim gameplay logic itself is multithreaded.",
      "council_json": "council-server-extra.json",
      "council_report": "council-server-extra-REPORT.md",
      "editorial_outcome": "accepted"
    },
    {
